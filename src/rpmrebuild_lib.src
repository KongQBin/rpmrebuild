###############################################################################
# common functions for all scripts
###############################################################################

function Debug
{
	if [ -n "$RPMREBUILD_debug" ]
	then
		echo -e "DEBUG: $*" 1>&2
	fi
}
###############################################################################
function Echo
{
	echo -e "$*"
}
###############################################################################
# common low level code for Error and Warning functions
function Logger
{
	# screen
	Echo "$0: $*" 1>&2
	# for optionnal bug report
	echo -e "$0: $*" >> "$RPMREBUILD_BUGREPORT"

}
###############################################################################
# to be used after a return code test
# propagate error code
# replace line as
# foo || return
# by
# foo || Error "pb foo" || return
function Error
{
	ret=$?
	Logger "ERROR: $*"
	return $ret
}
###############################################################################
function Warning
{
	Logger "WARNING: $*"
}
###############################################################################
function Critical
{
	Error "$*"
	exit 1
}
###############################################################################

function AskYesNo
{
	local Ans
	read -r -p "$* ? (y/N) " Ans
	Debug "(AskYesNo) $Ans"
	case "$Ans" in
		[yY]*) return 0;;
		[nN]*) return 1;;
		*)      return 1;;
	esac || return 1 # should not happened
	return 1 # should not happend
}

###############################################################################
function RmDir
{
	if [ $# -ne 1 ] || [ -z "$1" ]
	then
		Warning "Usage: RmDir <dir>"
		return 1
	fi
	# to ensure tmpdir is really emptied by rm -rf
	local Dir
	Dir="$1"
	if [ -d "$Dir" ]
	then
		rm -rf "$Dir" 2>/dev/null && return
		chmod -R 700 "$Dir" 2>/dev/null  # no return here !!!
		rm -rf "$Dir" || return
	fi
	return 0
}
###############################################################################
# on AIX the  --parents does not exists for mkdir command, so use -p option
# which exists on all unix os
# but Non-GNU mkdir -p may have slightly different semantic and return status
# is not allways the same
function Mkdir_p
{
	if [ $# -ne 1 ] || [ -z "$1" ]
	then
		Warning "Usage: Mkdir_p <dir>"
		return 1
	fi
	local Dir
	Dir="$1"
	mkdir -p "$Dir"
	# test result
	if [ -d "$Dir" ]
	then
		return 0
	else
		return 1
	fi
}
###############################################################################
# the decode_requires function in spec_func.src uses gnu awk syntax
# not posix
function TestAwk
{
	local tst
	tst=$( echo 1 | awk '{ print lshift($1,1) }' 2> /dev/null )
	if [ -n "$tst" ] && [ "$tst" -eq '2' ]
	then
		return 0
	else
		return 1
	fi
}
###############################################################################

###############################################################################
# Keep rpm macro definitions as arguments, not executable shell text.
function AddRpmDefine
{
    RPMREBUILD_DEFINE_ARGS+=(--define "$1")
    local quoted
    printf -v quoted '%q' "$1"
    RPMREBUILD_rpm_defines="$RPMREBUILD_rpm_defines --define $quoted"
}

# Split --additional flags with quotes and escapes, without evaluating commands.
# The resulting array preserves spaces inside quoted arguments.
function ParseBuildArguments
{
    local text="$1" char quote='' word='' started=no escaped=no i
    RPMREBUILD_PARSED_ARGS=()
    for ((i=0; i<${#text}; i++)); do
        char=${text:i:1}
        if [ "$escaped" = yes ]; then
            word+="$char"; escaped=no; continue
        fi
        case "$quote" in
            "'")
                if [ "$char" = "'" ]; then quote=''; else word+="$char"; fi
                ;;
            '"')
                case "$char" in
                    '"') quote='' ;;
                    '\')
                        case "${text:i+1:1}" in
                            '$'|'`'|'"'|'\') escaped=yes ;;
                            *) word+="$char" ;;
                        esac
                        ;;
                    *) word+="$char" ;;
                esac
                ;;
            *)
                case "$char" in
                    "'"|'"') quote="$char"; started=yes ;;
                    '\') escaped=yes; started=yes ;;
                    ' '|$'\t'|$'\n')
                        if [ "$started" = yes ]; then
                            RPMREBUILD_PARSED_ARGS+=("$word")
                            word=''; started=no
                        fi
                        ;;
                    *) word+="$char"; started=yes ;;
                esac
                ;;
        esac
    done
    if [ -n "$quote" ] || [ "$escaped" = yes ]; then
        Warning 'Unterminated quote or escape in --additional'
        return 1
    fi
    [ "$started" = no ] || RPMREBUILD_PARSED_ARGS+=("$word")
    return 0
}

function ValidateForceArch
{
    case "$FORCE_ARCH" in
        ''|*[!a-zA-Z0-9_]* )
            Warning 'Invalid --force-arch: use letters, digits and underscores'
            return 1
            ;;
    esac
}
